# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Stripe Secret Key (sk_test_...) for processing credit card donations.
# Put this in AI Studio secrets to enable real Stripe payments.
STRIPE_SECRET_KEY=""

# PRODUCTION FIREBASE CONFIGURATIONS (For Custom Domain / Vercel Deployments)
# Fill these in your Vercel Environment Variables to route to your production Firebase database:
VITE_FIREBASE_PROJECT_ID="donator-b3cbd"
VITE_FIREBASE_APP_ID="YOUR_PRODUCTION_APP_ID"
VITE_FIREBASE_API_KEY="YOUR_PRODUCTION_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="donator-b3cbd.firebaseapp.com"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)" # Normally "(default)" on standard Firebase
VITE_FIREBASE_STORAGE_BUCKET="donator-b3cbd.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_MEASUREMENT_ID=""
